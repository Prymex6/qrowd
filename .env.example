APP_NAME=QRowd
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Warsaw

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL rather than SQLite: the queue reads lean on window functions and the
# test suite runs against the same engine as production.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qrowd
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# Reverb carries queue changes to every phone in the room. Generate the three
# app credentials yourself; any random strings will do locally.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# What the browser connects to. These differ from the pair above as soon as the
# app sits behind a tunnel or a proxy, which is the usual reason the queue stops
# updating while everything else works.
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_PUBLIC_HOST}"
VITE_REVERB_PORT="${REVERB_PUBLIC_PORT}"
VITE_REVERB_SCHEME="${REVERB_PUBLIC_SCHEME}"

# Search falls back to the local catalogue when this is empty, so the app runs
# without a key — it just cannot find anything it has never played.
#
# The daily quota is the real constraint and cannot be raised with money, which
# is why the catalogue is asked first and the margin below leaves room to finish
# an evening once the alert threshold is crossed.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000
# A percentage of the daily quota, not a number of units.
YOUTUBE_QUOTA_ALERT_AT=70
# Units held back so an evening already under way can still finish.
YOUTUBE_QUOTA_SAFETY_MARGIN=1000

# Local music folders. Optional — only needed for offline playlists.
FFMPEG_PATH=
FFPROBE_PATH=

# Payments. Leave empty to run without them.
HOTPAY_SECRET=
HOTPAY_PASSWORD=

# open or closed - a flag, not a boolean.
QROWD_REGISTRATION=open
QROWD_FREE_PARTIES=2

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
